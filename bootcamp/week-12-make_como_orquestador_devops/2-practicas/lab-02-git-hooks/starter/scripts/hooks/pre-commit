#!/usr/bin/env bash
# pre-commit: validaciones rápidas antes de cada commit
set -euo pipefail

echo "→ [pre-commit] Verificando archivos staged..."

# Bloquea .env, .env.prod, config/.env.staging... pero deja pasar .env.example
if git diff --cached --name-only \
    | grep -E '(^|/)\.env(\.[^/]+)?$' \
    | grep -vE '\.env\.example$'; then
    echo "ERROR: archivo .env en staging. Agrega '.env*' y '!.env.example' a .gitignore."
    exit 1
fi

echo "✓ [pre-commit] OK"
