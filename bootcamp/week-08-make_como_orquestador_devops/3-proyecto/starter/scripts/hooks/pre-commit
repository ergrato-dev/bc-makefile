#!/bin/bash
set -e

echo "→ [pre-commit] Verificando archivos staged..."

if git diff --cached --name-only | grep -q '\.env$'; then
    echo "ERROR: Intentando commitear un archivo .env. Agrega .env a .gitignore."
    exit 1
fi

if git diff --cached --name-only | grep -q '\.venv'; then
    echo "ERROR: Intentando commitear el directorio .venv/."
    exit 1
fi

echo "✓ [pre-commit] OK"
