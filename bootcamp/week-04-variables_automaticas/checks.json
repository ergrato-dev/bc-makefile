{
  "semana": "04",
  "titulo": "Variables automáticas",
  "checks": [
    {
      "id": "binario-funciona",
      "descripcion": "make all desde cero produce build/app y el binario imprime producto(3, 4) = 12",
      "cmd": "{make} -C {proyecto} clean >/dev/null 2>&1; {make} -C {proyecto} all >/dev/null 2>&1 && {proyecto}/build/app",
      "assert": "stdout~producto.3, 4. = 12",
      "pista": "3-proyecto/README.md, sección 1 y 5"
    },
    {
      "id": "objetos-en-build",
      "descripcion": "Cada src/*.c produce su objeto en build/",
      "cmd": "{make} -C {proyecto} all >/dev/null 2>&1; test -f {proyecto}/build/main.o && test -f {proyecto}/build/greet.o && test -f {proyecto}/build/calc.o",
      "assert": "exit0",
      "pista": "2-practicas/lab-05-rutas-dinamicas/README.md"
    },
    {
      "id": "segunda-pasada-sin-trabajo",
      "descripcion": "Una segunda ejecución de make all no rehace nada",
      "cmd": "{make} -C {proyecto} all >/dev/null 2>&1; test -x {proyecto}/build/app && {make} -C {proyecto} all",
      "assert": "stdout~Nothing to be done|is up to date",
      "pista": "3-proyecto/README.md, sección 2"
    },
    {
      "id": "incremental-un-objeto",
      "descripcion": "Tocar un .c recompila solo ese objeto",
      "cmd": "{make} -C {proyecto} all >/dev/null 2>&1; touch {proyecto}/src/greet.c && {make} -C {proyecto} all 2>&1 | grep -c '^.cc.  *src/'",
      "assert": "stdout~^1$",
      "pista": "3-proyecto/README.md, sección 2"
    },
    {
      "id": "deps-generadas",
      "descripcion": "El build genera un archivo .d de dependencias por objeto",
      "cmd": "{make} -C {proyecto} all >/dev/null 2>&1; ls {proyecto}/build/*.d 2>/dev/null | wc -l",
      "assert": "stdout~^ *3$",
      "pista": "1-teoria/01-contexto.md, sección Headers"
    },
    {
      "id": "header-recompila",
      "descripcion": "Tocar include/calc.h recompila exactamente los dos objetos que lo incluyen",
      "cmd": "{make} -C {proyecto} all >/dev/null 2>&1; touch {proyecto}/include/calc.h && {make} -C {proyecto} all 2>&1 | grep -c '^.cc.  *src/'",
      "assert": "stdout~^2$",
      "pista": "1-teoria/01-contexto.md, sección Headers"
    },
    {
      "id": "cc-desde-cli",
      "descripcion": "CC se puede cambiar desde la línea de comandos",
      "cmd": "{make} -C {proyecto} -n -B all CC=clang",
      "assert": "stdout~(^|[[:space:]])clang .*-c ",
      "pista": "3-proyecto/README.md, tabla de variables"
    },
    {
      "id": "clean-borra-build",
      "descripcion": "make clean elimina build/ por completo",
      "cmd": "{make} -C {proyecto} all >/dev/null 2>&1; test -d {proyecto}/build && {make} -C {proyecto} clean >/dev/null && test ! -e {proyecto}/build",
      "assert": "exit0",
      "pista": "3-proyecto/README.md, sección 3"
    },
    {
      "id": "clean-con-guarda",
      "descripcion": "make clean se niega a borrar si BUILD_DIR está vacío",
      "cmd": "{make} -C {proyecto} clean BUILD_DIR=",
      "assert": "stdout~BUILD_DIR vac",
      "pista": "Semana 03: guardas de rm -rf; plantilla en el TODO de clean"
    },
    {
      "id": "shellflags-estrictas",
      "descripcion": "El Makefile ejecuta las recetas con bash -eu -o pipefail",
      "cmd": "{make} -C {proyecto} -p __nada__ 2>/dev/null | grep -E '^[.]SHELLFLAGS :?= -eu -o pipefail'",
      "assert": "exit0",
      "pista": "Semana 03: preámbulo estricto; TODO del inicio del starter"
    },
    {
      "id": "delete-on-error",
      "descripcion": "El Makefile declara .DELETE_ON_ERROR",
      "cmd": "{make} -C {proyecto} -p __nada__ 2>/dev/null | grep -q '^[.]DELETE_ON_ERROR:'",
      "assert": "exit0",
      "pista": "Semana 03: preámbulo estricto; TODO del inicio del starter"
    }
  ]
}
